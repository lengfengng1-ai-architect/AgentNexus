{
  "actions": [
    {
      "title": "行动标题",
      "description": "行动描述（100字以内）",
      "start_date": "开始日期，如'7月25日'",
      "end_date": "结束日期，如'8月5日'",
      "priority": "高/中/普通",
      "category": "分类：达人合作/赛事活动/内容制作/平台投放/运营资源"
    }
  ]
}

