{
  "version": "0.0.1",
  "autoPort": false,
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "app.main:app", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}/backend",
      "port": 8000
    },
    {
      "name": "prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "3458", "--bind", "127.0.0.1"],
      "port": 3458
    },
    {
      "name": "frontend5174",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "${workspaceFolder}/frontend/dist", "-p", "5174", "-s", "--no-clipboard"],
      "port": 5174
    }
  ]
}
