{
  "version": "0.0.1",
  "autoPort": false,
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5178"],
      "cwd": "${workspaceFolder}/frontend",
      "port": 5178
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "app.main:app", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}/backend",
      "port": 8000
    }
  ]
}
