{
  "version": "0.0.1",
  "autoPort": true,
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "port": 5173
, "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "app.main:app", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}/backend",
      "port": 8000
    },
    {
      "name": "prototype",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "${workspaceFolder}", "-p", "3457", "-s", "--no-clipboard"],
      "port": 3457
    },
    {
      "name": "frontend5174",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "${workspaceFolder}/frontend/dist", "-p", "5174", "-s", "--no-clipboard"],
      "port": 5174
    }
  ]
}
